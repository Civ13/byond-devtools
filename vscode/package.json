{
  "name": "byond-devtools-vscode",
  "displayName": "BYOND Map Editor",
  "description": "View and edit BYOND .dmm maps (rendered tiles from the native type tree; place, erase, stamp and move objects, edit vars, undo/redo, verified saves), plus DreamMaker compile errors in the Problems panel and local playtests.",
  "version": "0.5.0",
  "publisher": "civ13",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Civ13/byond-devtools"
  },
  "homepage": "https://github.com/Civ13/byond-devtools/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/Civ13/byond-devtools/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#3b3226",
    "theme": "dark"
  },
  "keywords": [
    "byond",
    "map editor",
    "dream maker",
    "dmm",
    "map",
    "ss13",
    "civ13"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.cjs",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "byondDevtools.mapPreview",
        "displayName": "BYOND Map Editor",
        "selector": [
          {
            "filenamePattern": "*.dmm"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "byondDevtools.openPreview",
        "title": "Open BYOND Map Editor",
        "category": "BYOND"
      },
      {
        "command": "byondDevtools.compile",
        "title": "Compile project",
        "category": "BYOND"
      },
      {
        "command": "byondDevtools.playtest",
        "title": "Start local playtest",
        "category": "BYOND"
      },
      {
        "command": "byondDevtools.compareIcon",
        "title": "Compare icon with git revision",
        "category": "BYOND"
      },
      {
        "command": "byondDevtools.resizeMap",
        "title": "Resize map",
        "category": "BYOND"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "byondDevtools.openPreview",
          "when": "resourceExtname == .dmm"
        },
        {
          "command": "byondDevtools.compareIcon",
          "when": "resourceExtname == .dmi"
        },
        {
          "command": "byondDevtools.resizeMap",
          "when": "resourceExtname == .dmm"
        }
      ],
      "editor/title": [
        {
          "command": "byondDevtools.openPreview",
          "when": "resourceExtname == .dmm"
        },
        {
          "command": "byondDevtools.compareIcon",
          "when": "resourceExtname == .dmi"
        },
        {
          "command": "byondDevtools.resizeMap",
          "when": "resourceExtname == .dmm"
        }
      ]
    },
    "configuration": {
      "title": "BYOND Map Editor",
      "properties": {
        "byondDevtools.byondBin": {
          "type": "string",
          "default": "",
          "description": "BYOND bin folder (with DreamMaker/dm.exe). Used to read the project's type tree with DreamMaker -o.",
          "scope": "machine-overridable"
        },
        "byondDevtools.typeTree": {
          "type": "string",
          "default": "",
          "description": "A saved type tree (DreamMaker -o output) to use instead of running DreamMaker. Relative to the workspace folder."
        },
        "byondDevtools.dme": {
          "type": "string",
          "default": "",
          "description": "The project .dme, relative to the workspace folder. Default: the only .dme at the folder root."
        },
        "byondDevtools.playtestMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "How long a local playtest runs before the world shuts itself down."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "test": "node integration/run.mjs",
    "package": "npm run bundle && vsce package --no-dependencies --out byond-map-preview.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  }
}
